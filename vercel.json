{
  "framework": "nextjs",
  "buildCommand": "find .next -mindepth 1 -maxdepth 1 ! -name cache -exec rm -rf {} + 2>/dev/null; npx prisma migrate deploy && next build",
  "installCommand": "npm install",
  "ignoreCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then exit 1; fi; git diff --quiet HEAD^ HEAD -- . ':(exclude)docs' ':(exclude)*.md' ':(exclude).github'",
  "regions": ["icn1"],
  "functions": {
    "app/api/reports/upload/route.ts": {
      "maxDuration": 60
    },
    "app/api/sh/inventory/import/route.ts": {
      "maxDuration": 60
    },
    "app/api/sh/shipping/import/route.ts": {
      "maxDuration": 60
    },
    "app/api/slack/events/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/billing-charge/route.ts": {
      "maxDuration": 300
    },
    "app/api/sh/products/[productId]/extract/url/route.ts": {
      "maxDuration": 30
    },
    "app/api/sh/products/[productId]/extract/files/route.ts": {
      "maxDuration": 30
    },
    "app/api/sh/products/[productId]/extract/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/billing-charge",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/inventory-stale-check",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/reorder-settle",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/agent-actions-expire",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/agent-conversations-sweep",
      "schedule": "0 4 * * *"
    }
  ]
}
