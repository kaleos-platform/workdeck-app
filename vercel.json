{
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "fix/hiring-cleanup-source-no-preview": false,
      "fix/recruiting-excel-no-preview": false,
      "fix/recruiting-image-size-limit": false
    }
  },
  "buildCommand": "find .next -mindepth 1 -maxdepth 1 ! -name cache -exec rm -rf {} + 2>/dev/null; npx prisma migrate deploy && next build && { test -z \"$(find .next/static -name '*.map' -print -quit)\" || { echo 'sourcemap left in .next/static'; exit 1; }; }",
  "installCommand": "npm install",
  "ignoreCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then exit 1; fi; git diff --quiet HEAD^ HEAD -- . ':(exclude)docs' ':(exclude)*.md' ':(exclude).github'",
  "regions": ["icn1"],
  "functions": {
    "app/api/reports/upload/route.ts": {
      "maxDuration": 60
    },
    "app/api/sh/inventory/import/route.ts": {
      "maxDuration": 60
    },
    "app/api/sh/shipping/import/route.ts": {
      "maxDuration": 60
    },
    "app/api/slack/events/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/wekeep-weekly-reconcile/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/billing-charge/route.ts": {
      "maxDuration": 300
    },
    "app/api/sh/products/[productId]/extract/url/route.ts": {
      "maxDuration": 30
    },
    "app/api/sh/products/[productId]/extract/files/route.ts": {
      "maxDuration": 30
    },
    "app/api/sh/products/[productId]/extract/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/hiring-upload-sweep/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/hiring-upload-backfill/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/hiring-upload-cleanup/route.ts": {
      "maxDuration": 60
    },
    "app/api/collection/naver-nbaesong/ingest/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/channel-orders-cafe24/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/channel-orders-reconcile/route.ts": {
      "maxDuration": 300
    },
    "app/api/collection/channel-orders/ingest/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/cron/hiring-upload-cleanup", "schedule": "*/5 * * * *" },
    {
      "path": "/api/cron/wekeep-weekly-reconcile",
      "schedule": "0 0 * * 1"
    },
    {
      "path": "/api/cron/billing-charge",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/inventory-stale-check",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/reorder-settle",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/agent-actions-expire",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/agent-conversations-sweep",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/product-source-orphan-sweep",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/coupang-product-sync",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/coupang-write-jobs-reap",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/credential-health",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/sc-osmu-intake",
      "schedule": "*/10 * * * *"
    },
    { "path": "/api/cron/db-health", "schedule": "*/10 * * * *" },
    { "path": "/api/cron/hiring-daily-digest", "schedule": "0 0 * * *" },
    { "path": "/api/cron/platform-funnel-report", "schedule": "0 0 * * 1" },
    { "path": "/api/cron/channel-orders-cafe24", "schedule": "*/30 * * * *" },
    { "path": "/api/cron/channel-orders-reconcile", "schedule": "0 0,9 * * *" }
  ]
}
