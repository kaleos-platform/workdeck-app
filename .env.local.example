# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=

# 워커 인증 (맥미니 상주 워커 <-> 웹앱)
WORKER_API_KEY=

# 필드 암호화 v1 루트 키 (64-char hex, 키 ID k1). v1(AES-256-GCM)은 이 키에서 용도별 HKDF 키를 파생한다.
# 신규 환경: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# 환경(로컬/preview/운영)마다 반드시 다른 값을 쓴다. 운영 키는 비밀번호 관리자에 백업한다.
ENCRYPTION_KEY_V1=
# 키 회전 시에만: 새 루트 ENCRYPTION_KEY_V1_K2= 와 쓰기 키 ID ENCRYPTION_KEY_V1_ACTIVE_KID=k2 (계획 부록 "향후 키 회전 런북")
# 쓰기 형식 v0|v1. 비우면 운영(VERCEL_ENV=production)은 v0, 그 밖은 v1. 로컬은 비워 둔다.
# v0 은 ENCRYPTION_KEY 가 있어야 부팅된다(K0 보존 기간 전용).
# ENCRYPTION_WRITE_VERSION=
# v0(AES-256-CBC) 기존 암호문 읽기 전용 키. 값을 바꾸지 않는다.
# 백필(scripts/security/reencrypt-v0.ts) 완료 후 삭제. 신규 환경에는 두지 않는다.
ENCRYPTION_KEY=

# 배송 등록 우편번호 자동조회 (주소 → 우편번호) — 카카오 REST API 키
# 발급: developers.kakao.com > 내 애플리케이션 > 앱 키 > REST API 키
# 미설정 시 자동조회 버튼은 503 안내. 우편번호 컬럼·파일 매칭은 키 없이 동작.
KAKAO_REST_API_KEY=

# AI 분석 (쿠팡 광고 분석 리포트용) — 3단계 fallback
# 1차/2차: Gemini API Key (AI Studio)
GEMINI_API_KEY=
AI_PRIMARY_MODEL=gemini-2.5-flash
AI_FALLBACK_MODEL=gemini-2.5-pro
# 3차: 워커 호스트(맥미니) 로컬 Ollama. 아래 OLLAMA_ENDPOINT 공유.
AI_LOCAL_FALLBACK_MODEL=qwen3:14b

# ─── Sales Content Deck (Unit 3+) ───────────────────────────────────────────

# Claude Code ACP — 기존 Bridge 서비스(port 18800) 확장 경로.
# Bridge 쪽에 `/sales-content/generate` 라우트가 준비되면 활성화된다.
# 빈 값이면 자동 fallback(Ollama) 또는 503.
CLAUDE_CODE_ACP_ENDPOINT=http://127.0.0.1:18800

# 로컬 Ollama (ACP fallback)
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Gemini Imagen (이미지 AI). AI Studio API Key.
GOOGLE_AI_API_KEY=
GEMINI_IMAGE_MODEL=imagen-4.0-generate-001

# 이미지 월간 크레딧 기본값 (WorkspaceAiCredit 초기 imageQuota)
SALES_CONTENT_IMAGE_MONTHLY_QUOTA=50

# (선택) sc job 실패(non-retryable) 알림 webhook. Slack incoming webhook 호환 — JSON {text}.
# 미설정 시 알림 없음 (db-stats / SQL 로 fallback 모니터링).
SC_FAILURE_WEBHOOK_URL=

# 결제 (토스페이먼츠 — 테스트키는 대시보드 개발자센터에서 발급)
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=
